#!/usr/bin/env bash
# Wrapper: keep the cargo registry inside the workspace because the agent
# sandbox only permits writes under the session workspace.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export CARGO_HOME="${ROOT}/.cargo-home"
exec "${CARGO_REAL:-$HOME/.cargo/bin/cargo}" "$@"
